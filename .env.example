# Runtime environment: local, development, staging, or production
ENVIRONMENT=local

# PostgreSQL connection string. Replace credentials in your local .env only.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fraud_detection

# Local MLflow server or hosted tracking endpoint
MLFLOW_TRACKING_URI=http://localhost:5000

# Path to the model artifact selected for serving
MODEL_PATH=models/model.joblib

