# Copy to .env and set a strong local-only password before starting Compose.
# Use URL-safe characters (letters and numbers) because the API URL is assembled
# from these values. Do not reuse the host PostgreSQL password.
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=

# Host ports. PostgreSQL is separate from any host PostgreSQL on port 5432.
POSTGRES_HOST_PORT=5433
API_PORT=8000
DASHBOARD_PORT=8501

# Optional read-only directory of safe, aggregated simulator summaries.
# Defaults to an empty mount; the dashboard remains usable without summaries.
SIMULATION_REPORTS_DIR=

