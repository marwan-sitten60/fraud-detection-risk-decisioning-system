# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Packaging output
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files and secrets
.env
.env.*
!.env.example

# Data: keep directory structure, never commit local datasets
data/**
!data/raw/
!data/interim/
!data/processed/
!data/**/.gitkeep

# IEEE-CIS source files, even if they are placed outside data/raw by mistake
**/train_transaction.csv
**/train_identity.csv
**/test_transaction.csv
**/test_identity.csv
**/sample_submission.csv
**/ieee-fraud-detection.zip

# Model and experiment artifacts
models/**
!models/.gitkeep
*.joblib
*.pkl
*.pickle
*.onnx
mlruns/
mlartifacts/
artifacts/
.mlflow/
mlflow.db*

# Notebooks
.ipynb_checkpoints/
.jupyter/

# IDE and operating-system files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db

# Logs and local databases
*.log
*.db
*.sqlite
*.sqlite3

